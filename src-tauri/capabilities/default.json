{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas da janela principal.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "process:allow-restart",
    "process:allow-exit",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.mercadopago.com.br/*" },
        { "url": "https://www.mercadopago.com/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/updates/*" }]
    }
  ]
}
