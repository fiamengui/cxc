    "test:performance": "cargo test --manifest-path src-tauri/Cargo.toml database::tests::remains_responsive_at_the_reference_business_scale -- --nocapture",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
